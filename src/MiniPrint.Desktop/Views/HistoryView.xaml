<UserControl x:Class="MiniPrint.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Histórico" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Últimos trabalhos enviados. Impressões simuladas aparecem marcadas e nunca são contadas como impressão real." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="Atualizar" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" />
                <Button Content="Exportar CSV" Style="{StaticResource GhostButton}"
                        Command="{Binding ExportCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <Button Content="Limpar histórico" Style="{StaticResource DangerButton}"
                    Command="{Binding ClearCommand}" HorizontalAlignment="Right" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Entries}" Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data e hora" Binding="{Binding TimestampText}" Width="160" />
                        <DataGridTextColumn Header="Conteúdo" Binding="{Binding Title}" Width="*" MinWidth="170" ElementStyle="{StaticResource CellTrim}" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding KindText}" Width="80" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="95" />
                        <DataGridTextColumn Header="Dispositivo" Binding="{Binding DeviceName}" Width="170" ElementStyle="{StaticResource CellTrim}" />
                        <DataGridTextColumn Header="Linhas" Binding="{Binding LinesPrinted}" Width="70" />
                        <DataGridTextColumn Header="Bytes" Binding="{Binding BytesSent}" Width="75" />
                        <DataGridTextColumn Header="Erro" Binding="{Binding ErrorMessage}" Width="200" ElementStyle="{StaticResource CellTrim}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Nenhum trabalho registrado ainda" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="As impressões enviadas aparecerão aqui, com data, status e quantidade de linhas." Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="340" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="2,10,0,0" />
    </Grid>
</UserControl>
