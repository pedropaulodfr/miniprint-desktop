<UserControl x:Class="MiniPrint.Desktop.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MiniPrint.Desktop.Views"
             xmlns:vm="clr-namespace:MiniPrint.Desktop.ViewModels"
             Background="Transparent">

    <ContentControl Content="{Binding Current}">
        <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:TemplateListViewModel}">
                <views:TemplateListView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TemplateEditorViewModel}">
                <views:TemplateEditorView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:VisualEditorViewModel}">
                <views:VisualEditorView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TemplateFillViewModel}">
                <views:TemplateFillView />
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</UserControl>
