<UserControl x:Class="MiniPrint.Desktop.Views.TemplateFillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding TemplateName}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding TemplateDescription}" Style="{StaticResource PageSubtitle}"
                       Visibility="{Binding TemplateDescription, Converter={StaticResource EmptyStringToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Formulário -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Preencha os campos"
                               Style="{StaticResource SectionHeader}" Margin="16,14,16,6" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,12">
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Label}">
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                            <Run Text="{Binding RequiredMark, Mode=OneWay}"
                                                 Foreground="{StaticResource DangerBrush}" />
                                        </TextBlock>

                                        <!-- Lista de opções -->
                                        <ComboBox ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding Value}"
                                                  Visibility="{Binding IsList, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Data -->
                                        <DatePicker SelectedDate="{Binding DateValue}"
                                                    Visibility="{Binding IsDate, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Texto longo -->
                                        <TextBox Text="{Binding Value}"
                                                 AcceptsReturn="True"
                                                 MinHeight="56"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Visibility="{Binding IsLongText, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Com máscara (CPF, CNPJ, telefone, valor) -->
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                 Visibility="{Binding IsMasked, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Texto simples -->
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsPlainText, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{Binding Placeholder}"
                                                   Style="{StaticResource Mono}"
                                                   Margin="2,3,0,0"
                                                   Visibility="{Binding Placeholder, Converter={StaticResource EmptyStringToVisibility}}" />

                                        <TextBlock Text="{Binding Error}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontSize="11.5"
                                                   Margin="2,3,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Pré-visualização -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Documento" Style="{StaticResource SectionHeader}" Margin="0" />
                        <TextBlock Text="{Binding PreviewInfo}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource PreviewWell}">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource Paper}">
                                    <Image Source="{Binding PreviewImage}"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                            </ScrollViewer>

                            <TextBlock Text="Preencha os campos e clique em Visualizar documento."
                                       Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Visibility="{Binding HasNoPreview, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <CheckBox Content="Guardar os dados preenchidos no histórico"
                                  IsChecked="{Binding StoreDataInHistory}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="24,2,0,0"
                                   Text="Desligado por padrão: o histórico registra apenas o nome do modelo, sem dados pessoais." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="2,0,0,8" />

            <Grid Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVisibility}}"
                  Margin="0,0,0,8">
                <StackPanel>
                    <ProgressBar Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
                    <TextBlock Text="{Binding ProgressMessage}" Style="{StaticResource Muted}" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Voltar" Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" />
                    <Button Content="Limpar campos" Style="{StaticResource GhostButton}"
                            Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Visualizar documento" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviewCommand}" MinWidth="170" />
                    <Button Content="{Binding PrintButtonText}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding PrintCommand}" MinWidth="140" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
