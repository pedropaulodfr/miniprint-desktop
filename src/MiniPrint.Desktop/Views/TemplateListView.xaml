<UserControl x:Class="MiniPrint.Desktop.Views.TemplateListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Modelos" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Crie o documento uma vez, defina os campos e reutilize quantas vezes quiser. Ao imprimir, basta preencher os dados." />
        </StackPanel>

        <!-- Barra de ferramentas: criar à esquerda, localizar à direita -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                <Button Content="Novo documento" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewCommand}" />
                <Button Content="Novo (blocos)" Style="{StaticResource SecondaryButton}"
                        Command="{Binding NewFlowCommand}" Margin="8,0,0,0"
                        ToolTip="Editor de blocos, sem posicionamento livre" />
                <Button Content="Importar" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                <Button Content="Criar modelo de exemplo" Style="{StaticResource GhostButton}"
                        Command="{Binding AddSampleCommand}" Margin="4,0,0,0" />
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Pesquisar modelo pelo nome"
                         AutomationProperties.Name="Pesquisar modelo"
                         Width="210" />
                <ComboBox ItemsSource="{Binding SortModes}"
                          SelectedItem="{Binding SortMode}"
                          AutomationProperties.Name="Ordenar modelos"
                          Width="196" Margin="8,0,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource SortModeText}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16,10,6">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusCard}"
                                        Padding="18,14"
                                        Margin="0,0,6,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Visibility="{Binding Description, Converter={StaticResource EmptyStringToVisibility}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                <Border Style="{StaticResource BadgeAccent}" Margin="0,0,10,0" Padding="8,2">
                                                    <TextBlock Text="{Binding EditorModeText, Mode=OneWay}"
                                                               Style="{StaticResource BadgeTextAccent}" FontSize="11" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}">
                                                    <Run Text="{Binding FieldCount, Mode=OneWay}" />
                                                    <Run Text=" campo(s)  ·  atualizado em " />
                                                    <Run Text="{Binding UpdatedAtText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Utilizar" Style="{StaticResource PrimaryButton}"
                                                    MinWidth="88"
                                                    Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Editar" Style="{StaticResource SecondaryButton}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Duplicar" Style="{StaticResource GhostButton}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Exportar" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Excluir" Style="{StaticResource DangerGhostButton}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Estado vazio -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibility}}">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource AccentSoftBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="24"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Nenhum modelo cadastrado" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Muted}"
                               TextAlignment="Center" Margin="0,6,0,0" />
                    <Button Content="Criar o primeiro modelo" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="2,12,0,0" />
    </Grid>
</UserControl>
