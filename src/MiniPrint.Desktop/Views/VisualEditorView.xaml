<UserControl x:Class="MiniPrint.Desktop.Views.VisualEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}"
             Focusable="True"
             AllowDrop="True"
             PreviewMouseLeftButtonUp="OnPreviewMouseUp"
             PreviewKeyDown="OnPreviewKeyDown"
             KeyDown="OnKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= BARRA SUPERIOR ======================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Recolher/expandir painel esquerdo -->
                <Button Grid.Column="0" Style="{StaticResource IconButton}"
                        Command="{Binding ToggleLeftPanelCommand}"
                        ToolTip="{Binding LeftPanelToggleHint}">
                    <TextBlock Style="{StaticResource GlyphText}" Text="{Binding LeftPanelToggleGlyph}" />
                </Button>

                <!-- Identidade do documento -->
                <Grid Grid.Column="1" Margin="6,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14.5" FontWeight="SemiBold"
                             BorderThickness="0" Background="Transparent"
                             Padding="4,2" MaxWidth="420" HorizontalAlignment="Left"
                             MinWidth="180"
                             ToolTip="Nome do documento. É o título mostrado aqui e na lista de modelos." />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,1,0,0">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SaveStatusText}" Style="{StaticResource Muted}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="·" Style="{StaticResource Muted}" Margin="6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ValidationSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Grupos de comandos -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Style="{StaticResource IconButton}" Command="{Binding UndoCommand}"
                            ToolTip="Desfazer (Ctrl+Z)">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE7A7;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding RedoCommand}"
                            ToolTip="Refazer (Ctrl+Y)">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE7A6;" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button Style="{StaticResource IconButton}" Command="{Binding CutCommand}"
                            ToolTip="Recortar (Ctrl+X)">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8C6;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding CopyCommand}"
                            ToolTip="Copiar (Ctrl+C)">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8C8;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding PasteCommand}"
                            ToolTip="Colar (Ctrl+V)">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE77F;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"
                            ToolTip="Excluir (Delete)">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8B0;" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button Style="{StaticResource IconButton}" Command="{Binding CopyStyleCommand}"
                            ToolTip="Copiar estilo do elemento selecionado">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8E3;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding PasteStyleCommand}"
                            ToolTip="Aplicar o estilo copiado à seleção">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8FB;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding FindReplaceCommand}"
                            ToolTip="Localizar e substituir textos (Ctrl+F)">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE71C;" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button x:Name="AlignButton" Style="{StaticResource IconButton}"
                            ToolTip="Alinhar e distribuir" Click="OnAlignMenuClick">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8A9;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding DistributeHorizontalEvenCommand}"
                            ToolTip="Distribuir horizontalmente com espaçamento uniforme">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8E1;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding DistributeVerticalEvenCommand}"
                            ToolTip="Distribuir verticalmente com espaçamento uniforme">
                        <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8E0;" />
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding IsPrintPreview}"
                                  ToolTip="Ver como vai sair na impressão (Ctrl+P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE7B3;" Margin="0,0,6,0" />
                            <TextBlock Text="Prévia" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <!-- Finalização -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="Voltar"
                            Command="{Binding CancelCommand}" Padding="12,7" Margin="0,0,6,0"
                            ToolTip="Voltar à lista de modelos (Esc)" />
                    <Button Style="{StaticResource PrimaryButton}" Padding="14,7"
                            Command="{Binding SaveCommand}" ToolTip="Salvar documento (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="Salvar" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RightToggleButton" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                            Command="{Binding ToggleRightPanelCommand}"
                            ToolTip="{Binding RightPanelToggleHint}">
                        <TextBlock Style="{StaticResource GlyphText}" Text="{Binding RightPanelToggleGlyph}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= CONTEÚDO ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="236" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="RightColumn" Width="328" />
            </Grid.ColumnDefinitions>

            <!-- Paleta de elementos -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowLeftPanel, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                        <TextBox x:Name="PaletteSearchBox"
                                 Text="{Binding PaletteSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5" ToolTip="Pesquisar elementos (ex.: linha, campo, imagem)" />
                        <TextBlock Text="Pesquisar elementos..." Style="{StaticResource Muted}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding PaletteSearch, Converter={StaticResource EmptyTextToVisibility}}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,10">
                        <StackPanel>
                        <ItemsControl ItemsSource="{Binding PaletteGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <ToggleButton Style="{StaticResource ToolbarToggle}"
                                                      IsChecked="{Binding IsExpanded}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Left"
                                                      Padding="6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE70D;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="Text" Value="&#xE76C;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </ToggleButton>

                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource PaletteItemButton}"
                                                            PreviewMouseLeftButtonDown="OnPaletteItemMouseDown"
                                                            PreviewMouseMove="OnPaletteItemMouseMove"
                                                            ToolTip="{Binding Hint}">
                                                        <Button.Command>
                                                            <Binding Path="DataContext.InsertPaletteItemCommand"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </Button.Command>
                                                        <Button.CommandParameter>
                                                            <Binding />
                                                        </Button.CommandParameter>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                                       FontSize="13" Width="20" TextAlignment="Center"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Nenhum elemento corresponde à pesquisa." Style="{StaticResource Muted}"
                                   Margin="6,10,6,0" Visibility="{Binding HasPaletteResults, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"
                          Visibility="{Binding ShowLeftPanel, Converter={StaticResource BoolToVisibility}}"
                          DragCompleted="OnLeftSplitterDragCompleted"
                          Cursor="SizeWE" />

            <!-- Canvas -->
            <Grid Grid.Column="2" Background="{StaticResource AppBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sub-barra do canvas: zoom, grade e visualização -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Zoom" Style="{StaticResource Label}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                Command="{Binding ZoomOutCommand}" ToolTip="Reduzir zoom">
                            <TextBlock Style="{StaticResource GlyphText}" FontSize="11" Text="&#xE71F;" />
                        </Button>
                        <Slider x:Name="ZoomSlider" Width="96" Minimum="40" Maximum="300"
                                Value="{Binding ZoomPercentNumber, Mode=TwoWay}"
                                VerticalAlignment="Center" ToolTip="Zoom de 40% a 300% (Ctrl + roda)" />
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                Command="{Binding ZoomInCommand}" ToolTip="Ampliar zoom">
                            <TextBlock Style="{StaticResource GlyphText}" FontSize="11" Text="&#xE8A3;" />
                        </Button>
                        <TextBlock Text="{Binding ZoomPercent}" Style="{StaticResource Mono}" MinWidth="38"
                                   Margin="2,0,4,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ToolbarButton}" Content="Ajustar" Padding="6,4"
                                Click="OnFitToWidth" ToolTip="Ajustar à largura da janela (Ctrl+0)" />
                        <Button Style="{StaticResource ToolbarButton}" Content="100%" Padding="6,4"
                                Command="{Binding Zoom100Command}" ToolTip="Zoom de 100%" />

                        <Rectangle Style="{StaticResource ToolbarSeparator}" />

                        <TextBlock Text="Grade" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding GridSize, UpdateSourceTrigger=LostFocus}" Width="38"
                                 Padding="6,3" ToolTip="Tamanho da grade, em pontos" />

                        <Rectangle Style="{StaticResource ToolbarSeparator}" />

                        <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowGrid}"
                                      ToolTip="Mostrar grade">
                            <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE80A;" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding SnapToGrid}"
                                      ToolTip="Encaixar na grade, margens e elementos">
                            <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE71B;" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding SnapToObjects}"
                                      ToolTip="Encaixar nas bordas e centros dos outros elementos">
                            <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE8B3;" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowMargins}"
                                      ToolTip="Mostrar limites da área imprimível">
                            <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE7C8;" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowGuides}"
                                      ToolTip="Mostrar guias de alinhamento">
                            <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE809;" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowRulers}"
                                      ToolTip="Mostrar régua">
                            <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE8A1;" />
                        </ToggleButton>
                    </WrapPanel>
                </Border>
                <!-- Área de rolagem com o papel -->
                <Border Grid.Row="1" ClipToBounds="True">
                    <ScrollViewer x:Name="CanvasScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  Padding="0"
                                  PreviewMouseWheel="OnCanvasMouseWheel">
                        <Grid Margin="36,22,36,32" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid x:Name="Sheet" Width="{Binding PaperWidth}">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                                </Grid.LayoutTransform>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Canvas x:Name="TopRuler" Grid.Row="0" Height="16"
                                        Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVisibility}}"
                                        IsHitTestVisible="False" />

                                <Border x:Name="Paper" Grid.Row="1"
                                        Width="{Binding PaperWidth}"
                                        Height="{Binding CanvasHeight}"
                                        Background="White"
                                        BorderBrush="#D6DAE1" BorderThickness="1"
                                        MouseLeftButtonDown="OnPaperMouseDown"
                                        MouseMove="OnPaperMouseMove"
                                        MouseLeftButtonUp="OnPaperMouseUp"
                                        AllowDrop="True"
                                        Drop="OnPaperDrop"
                                        DragOver="OnPaperDragOver">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#8899A8" BlurRadius="18" ShadowDepth="3"
                                                          Opacity="0.35" Direction="270" />
                                    </Border.Effect>

                                    <Grid Background="Transparent">
                                        <!-- Grade -->
                                        <Rectangle Fill="{Binding GridBrush}"
                                                   Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}"
                                                   IsHitTestVisible="False" />

                                        <!-- Área imprimível -->
                                        <Rectangle Fill="Transparent" Stroke="#330F766E" StrokeThickness="1"
                                                   StrokeDashArray="3 3"
                                                   Margin="{Binding MarginThickness}"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding ShowMargins, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Elementos -->
                                        <ItemsControl ItemsSource="{Binding Elements}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="{Binding Width}" Height="{Binding Height}"
                                                          Background="Transparent"
                                                          MouseLeftButtonDown="OnElementMouseDown"
                                                          MouseMove="OnElementMouseMove"
                                                          MouseLeftButtonUp="OnElementMouseUp"
                                                          MouseRightButtonDown="OnElementRightButtonDown"
                                                          Cursor="SizeAll"
                                                          Visibility="{Binding Visible, Converter={StaticResource BoolToVisibility}}">

                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   IsHitTestVisible="False"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="None"
                                                                   FontFamily="{Binding FontFamily}"
                                                                   FontSize="{Binding FontSize, Converter={StaticResource PointsToDip}}"
                                                                   TextAlignment="{Binding Alignment, Converter={StaticResource Alignment}}"
                                                                   Visibility="{Binding ShowsText, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#111111" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Bold}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Italic}" Value="True">
                                                                            <Setter Property="FontStyle" Value="Italic" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsField}" Value="True">
                                                                            <Setter Property="Foreground" Value="#0F766E" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Image Source="{Binding ImageData, Converter={StaticResource Base64Image}}"
                                                               Stretch="Uniform" IsHitTestVisible="False"
                                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />

                                                        <Rectangle Fill="#111111" Height="{Binding Thickness}"
                                                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                                                   Visibility="{Binding IsLine, Converter={StaticResource BoolToVisibility}}" />

                                                        <Border BorderBrush="#111111" BorderThickness="1"
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding IsRectangle, Converter={StaticResource BoolToVisibility}}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Filled}" Value="True">
                                                                            <Setter Property="Background" Value="#111111" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>

                                                        <!-- Contorno de seleção -->
                                                        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />

                                                        <!-- Alças: 4 cantos + 4 lados -->
                                                        <Rectangle Width="7" Height="7" Fill="White" Stroke="{StaticResource AccentBrush}"
                                                                   StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                   Margin="-4,-4,0,0" Tag="NW" Cursor="SizeNWSE"
                                                                   MouseLeftButtonDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove"
                                                                   MouseLeftButtonUp="OnElementMouseUp"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                        <Rectangle Width="7" Height="7" Fill="White" Stroke="{StaticResource AccentBrush}"
                                                                   StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                   Margin="0,-4,-4,0" Tag="NE" Cursor="SizeNESW"
                                                                   MouseLeftButtonDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove"
                                                                   MouseLeftButtonUp="OnElementMouseUp"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                        <Rectangle Width="7" Height="7" Fill="White" Stroke="{StaticResource AccentBrush}"
                                                                   StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                   Margin="-4,0,0,-4" Tag="SW" Cursor="SizeNESW"
                                                                   MouseLeftButtonDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove"
                                                                   MouseLeftButtonUp="OnElementMouseUp"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                        <Rectangle Width="7" Height="7" Fill="White" Stroke="{StaticResource AccentBrush}"
                                                                   StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                   Margin="0,0,-4,-4" Tag="SE" Cursor="SizeNWSE"
                                                                   MouseLeftButtonDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove"
                                                                   MouseLeftButtonUp="OnElementMouseUp"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />

                                                        <Rectangle Width="7" Height="7" Fill="White" Stroke="{StaticResource AccentBrush}"
                                                                   StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                                   Margin="0,-4,0,0" Tag="N" Cursor="SizeNS"
                                                                   MouseLeftButtonDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove"
                                                                   MouseLeftButtonUp="OnElementMouseUp"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                        <Rectangle Width="7" Height="7" Fill="White" Stroke="{StaticResource AccentBrush}"
                                                                   StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                                   Margin="0,0,0,-4" Tag="S" Cursor="SizeNS"
                                                                   MouseLeftButtonDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove"
                                                                   MouseLeftButtonUp="OnElementMouseUp"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                        <Rectangle Width="7" Height="7" Fill="White" Stroke="{StaticResource AccentBrush}"
                                                                   StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                   Margin="-4,0,0,0" Tag="W" Cursor="SizeWE"
                                                                   MouseLeftButtonDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove"
                                                                   MouseLeftButtonUp="OnElementMouseUp"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                        <Rectangle Width="7" Height="7" Fill="White" Stroke="{StaticResource AccentBrush}"
                                                                   StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Margin="0,0,-4,0" Tag="E" Cursor="SizeWE"
                                                                   MouseLeftButtonDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove"
                                                                   MouseLeftButtonUp="OnElementMouseUp"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Guias de encaixe -->
                                        <ItemsControl ItemsSource="{Binding Guides}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                          Stroke="#FFEC4899" StrokeThickness="1" StrokeDashArray="4 2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Retângulo de seleção por área -->
                                        <Rectangle x:Name="MarqueeRectangle" Fill="#220F766E" Stroke="#AA0F766E"
                                                   StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False" />

                                        <!-- Estado vazio -->
                                        <Border Background="{StaticResource AppBackgroundBrush}" Visibility="{Binding Elements.Count, Converter={StaticResource ZeroToVisibility}}"
                                                IsHitTestVisible="True">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        MaxWidth="300">
                                                <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="Seu documento está vazio" FontSize="15" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,10,0,4" />
                                                <TextBlock Text="Adicione um texto, campo ou elemento gráfico para começar. Você também pode arrastar itens da paleta."
                                                           Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" />
                                                <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                                                    <Button Content="Texto" Style="{StaticResource SecondaryButton}"
                                                            Padding="10,6" Margin="3"
                                                            Command="{Binding InsertPaletteItemCommand}"
                                                            CommandParameter="text" />
                                                    <Button Content="Título" Style="{StaticResource SecondaryButton}"
                                                            Padding="10,6" Margin="3"
                                                            Command="{Binding InsertPaletteItemCommand}"
                                                            CommandParameter="title" />
                                                    <Button Content="Linha" Style="{StaticResource SecondaryButton}"
                                                            Padding="10,6" Margin="3"
                                                            Command="{Binding InsertPaletteItemCommand}"
                                                            CommandParameter="line" />
                                                    <Button Content="Campo" Style="{StaticResource SecondaryButton}"
                                                            Padding="10,6" Margin="3"
                                                            Command="{Binding NewFieldDialogCommand}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Edição de texto direto no canvas -->
                                        <Canvas x:Name="InlineEditorLayer" Visibility="Collapsed">
                                            <TextBox x:Name="InlineTextBox"
                                                     Text="{Binding InlineEditText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     Background="#FFFDF7" BorderBrush="{StaticResource AccentBrush}"
                                                     BorderThickness="1" Padding="2"
                                                     FontFamily="{Binding SelectedElement.FontFamily}"
                                                     FontSize="{Binding SelectedElement.FontSize, Converter={StaticResource PointsToDip}}"
                                                     LostFocus="OnInlineTextBoxLostFocus"
                                                     PreviewKeyDown="OnInlineTextBoxKeyDown" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Rodapé do canvas -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding AutoSaveText}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding PreviewInfo}" Style="{StaticResource Mono}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"
                          Visibility="{Binding ShowRightPanel, Converter={StaticResource BoolToVisibility}}"
                          DragCompleted="OnRightSplitterDragCompleted"
                          Cursor="SizeWE" />

            <!-- Propriedades, campos e camadas -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowRightPanel, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,12,16">
                    <StackPanel>

                        <!-- Documento (quando nada está selecionado) -->
                        <Border Style="{StaticResource PanelCard}"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Documento" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Nome do documento" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Descrição" Style="{StaticResource Label}" Margin="0,8,0,4" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Largura (pontos)" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding PaperWidth, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Margem esq./dir." Style="{StaticResource Label}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding MarginLeft, UpdateSourceTrigger=LostFocus}" />
                                            <TextBox Grid.Column="2" Text="{Binding MarginRight, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Altura automática do documento" IsChecked="{Binding AutoHeight}"
                                          Margin="0,8,0,0" />
                                <CheckBox Content="Salvar rascunho automaticamente" IsChecked="{Binding AutoSaveEnabled}"
                                          Margin="0,4,0,0"
                                          ToolTip="Guarda um rascunho durante a edição para recuperar em caso de fechamento inesperado" />
                                <TextBlock Text="Selecione um elemento no papel para editar suas propriedades."
                                           Style="{StaticResource Muted}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Propriedades do elemento -->
                        <Border Style="{StaticResource PanelCard}"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Propriedades" Style="{StaticResource SectionHeader}" Margin="0" />
                                    <TextBlock Text="{Binding SelectionCountText}" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding SelectionBounds}" Style="{StaticResource Mono}" Margin="0,2,0,8" />

                                <!-- Posição e tamanho -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding SelectedElement.X, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding SelectedElement.Y, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Larg." Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding SelectedElement.Width, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Alt." Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding SelectedElement.Height, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Nome na camada" Style="{StaticResource Label}" Margin="0,8,0,4" />
                                <TextBox Text="{Binding SelectedElement.Name, UpdateSourceTrigger=PropertyChanged}" />

                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox Content="Visível" IsChecked="{Binding SelectedElement.Visible}" Margin="0,0,12,0" />
                                    <CheckBox Content="Bloqueado" IsChecked="{Binding SelectedElement.Locked}" />
                                </WrapPanel>

                                <!-- Texto -->
                                <StackPanel Visibility="{Binding SelectedShowsText, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Divider}" />
                                    <TextBlock Text="Conteúdo" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding SelectedText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap"
                                             FontFamily="{StaticResource MonoFont}" />

                                    <StackPanel Visibility="{Binding SelectedIsField, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Campo associado" Style="{StaticResource Label}" Margin="0,8,0,4" />
                                        <ComboBox ItemsSource="{Binding FieldChoices}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Key"
                                                  SelectedValue="{Binding SelectedElement.FieldKey}" />
                                    </StackPanel>

                                    <TextBlock Text="Fonte" Style="{StaticResource Label}" Margin="0,10,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding FontFamilies}"
                                                  SelectedItem="{Binding SelectedElement.FontFamily}" />
                                        <TextBox Grid.Column="2" Text="{Binding SelectedElement.FontSize, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Tamanho em pontos" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <ToggleButton Style="{StaticResource ToolbarToggle}" Width="27" Height="30"
                                                          IsChecked="{Binding SelectedElement.Bold}" ToolTip="Negrito (Ctrl+B)">
                                                <TextBlock Text="B" FontWeight="Bold" />
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource ToolbarToggle}" Width="27" Height="30"
                                                          IsChecked="{Binding SelectedElement.Italic}" ToolTip="Itálico (Ctrl+I)">
                                                <TextBlock Text="I" FontStyle="Italic" />
                                            </ToggleButton>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Alinhamento" Style="{StaticResource Label}" />
                                            <ComboBox ItemsSource="{Binding Alignments}"
                                                      SelectedItem="{Binding SelectedElement.Alignment}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Se não couber" Style="{StaticResource Label}" />
                                            <ComboBox ItemsSource="{Binding OverflowModes}"
                                                      SelectedItem="{Binding SelectedElement.Overflow}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Entrelinhas" Style="{StaticResource Label}" Margin="0,8,0,4" />
                                    <TextBox Text="{Binding SelectedElement.LineSpacing, UpdateSourceTrigger=LostFocus}" />

                                    <CheckBox Content="Altura automática" IsChecked="{Binding SelectedElement.AutoHeight}"
                                              ToolTip="A altura acompanha o texto digitado" />
                                </StackPanel>

                                <!-- Imagem -->
                                <StackPanel Visibility="{Binding SelectedIsImage, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Divider}" />
                                    <Button Content="Escolher imagem..." Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ChooseImageCommand}" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{Binding SelectedElement.ImagePath}" Style="{StaticResource Mono}"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Brilho" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding SelectedElement.Brightness, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Contraste" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding SelectedElement.Contrast, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Meio-tom" Style="{StaticResource Label}" Margin="0,8,0,4" />
                                    <ComboBox ItemsSource="{Binding DitheringModes}"
                                              SelectedItem="{Binding SelectedElement.Dithering}" />
                                    <TextBlock Text="Rotação" Style="{StaticResource Label}" Margin="0,8,0,4" />
                                    <ComboBox ItemsSource="{Binding Rotations}"
                                              SelectedItem="{Binding SelectedElement.Rotation}" />
                                    <CheckBox Content="Manter proporção" IsChecked="{Binding SelectedElement.KeepAspect}" />
                                </StackPanel>

                                <!-- Linha e retângulo -->
                                <StackPanel Visibility="{Binding SelectedIsLine, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Divider}" />
                                    <TextBlock Text="Espessura" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding SelectedElement.Thickness, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding SelectedIsRect, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Divider}" />
                                    <TextBlock Text="Espessura da borda" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding SelectedElement.Thickness, UpdateSourceTrigger=LostFocus}" />
                                    <CheckBox Content="Preenchido" IsChecked="{Binding SelectedElement.Filled}" />
                                </StackPanel>

                                <!-- Campo dinâmico -->
                                <StackPanel Visibility="{Binding HasSelectedField, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid>
                                        <TextBlock Text="Campo dinâmico" Style="{StaticResource SectionHeader}" Margin="0" />
                                        <Button Content="Editar..." Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Right" Padding="6,2"
                                                Command="{Binding EditFieldDialogCommand}" />
                                    </Grid>
                                    <TextBlock Text="Rótulo exibido ao preencher" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding SelectedFieldLabel, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Tipo de dado" Style="{StaticResource Label}" Margin="0,8,0,4" />
                                    <ComboBox ItemsSource="{Binding FieldTypes}"
                                              DisplayMemberPath="Label" SelectedValuePath="Type"
                                              SelectedValue="{Binding SelectedFieldType}" />
                                    <CheckBox Content="Obrigatório" IsChecked="{Binding SelectedFieldRequired}" />
                                    <TextBlock Text="{Binding SelectedFieldKeyHint}" Style="{StaticResource Mono}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Campos do documento -->
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Campos do documento" Style="{StaticResource SectionHeader}" Margin="0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Limpar sem uso" Style="{StaticResource GhostButton}" Padding="6,2"
                                                Command="{Binding DeleteUnusedFieldsCommand}"
                                                ToolTip="Excluir campos que não aparecem no documento"
                                                Visibility="{Binding HasUnusedFields, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="+ Novo" Style="{StaticResource GhostButton}" Padding="6,2"
                                                Command="{Binding NewFieldDialogCommand}"
                                                ToolTip="Criar um campo dinâmico" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding FieldCountText}" Style="{StaticResource Muted}" />
                                    <TextBlock Text=" · " Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding UnusedFieldsText}" Style="{StaticResource Muted}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding FieldChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FieldRowBorder}" ToolTip="{Binding TypeText}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource Mono}">
                                                            <Run Text="{Binding TypeText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                                                Command="{Binding DataContext.InsertFieldAtEndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Inserir este campo no documento">
                                                            <TextBlock Style="{StaticResource GlyphText}" FontSize="11" Text="&#xE710;" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                                                Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Excluir este campo">
                                                            <TextBlock Style="{StaticResource GlyphText}" FontSize="11" Text="&#xE74D;" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Camadas -->
                        <Border Style="{StaticResource PanelCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Camadas" Style="{StaticResource SectionHeader}" />
                                <TextBox DockPanel.Dock="Top" x:Name="LayerSearchBox"
                                         Text="{Binding LayerSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="7,4" Margin="0,0,0,6"
                                         ToolTip="Pesquisar camadas por nome" />
                                <ListBox ItemsSource="{Binding FilteredLayers}"
                                         SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                                         MinHeight="120" MaxHeight="280"
                                         Background="{StaticResource SurfaceAltBrush}"
                                         SelectionMode="Extended"
                                         SelectionChanged="OnLayersSelectionChanged"
                                         PreviewMouseLeftButtonDown="OnLayerMouseDown"
                                         PreviewMouseMove="OnLayerMouseMove"
                                         Drop="OnLayerDrop"
                                         AllowDrop="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding KindGlyph}"
                                                           FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Width="18" TextAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Margin="4,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding KindText}" Style="{StaticResource Mono}" />
                                                </StackPanel>

                                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="4,2"
                                                        ToolTip="Mostrar/ocultar"
                                                        Command="{Binding DataContext.ToggleVisibilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="11" Opacity="0.75">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Visible}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.3" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="4,2"
                                                        ToolTip="Bloquear/desbloquear"
                                                        Command="{Binding DataContext.ToggleLockElementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Opacity" Value="0.35" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Locked}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ======================= MODO IMPRESSÃO ======================= -->
        <Border Grid.Row="1" Background="{StaticResource AppBackgroundBrush}"
                Visibility="{Binding IsPrintPreview, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pré-visualização" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PreviewInfo}" Style="{StaticResource Mono}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <Button Content="Voltar ao editor" Style="{StaticResource SecondaryButton}"
                                Command="{Binding Zoom100Command}" Visibility="Collapsed" />
                        <Button Content="Imprimir teste" Style="{StaticResource SecondaryButton}"
                                Command="{Binding PrintCommand}" Margin="12,0,0,0" Padding="10,5"
                                ToolTip="Imprime com valores de exemplo dos campos" />
                        <Button Content="Fechar prévia" Style="{StaticResource PrimaryButton}" Padding="10,5"
                                Margin="8,0,0,0" Click="OnClosePreview"
                                ToolTip="Voltar à edição (Esc)" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Border Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Image Source="{Binding PreviewImage}" Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ======================= BOAS-VINDAS ======================= -->
        <Border Grid.Row="1" Background="#CC111827"
                Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22"
                    MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Bem-vindo ao editor de modelos" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="Crie recibos, comprovantes e etiquetas arrastando elementos para o papel." />
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Muted}" Text="• Clique em um item da paleta ou arraste-o para o papel." />
                        <TextBlock Style="{StaticResource Muted}" Text="• Arraste os elementos e use as alças para redimensionar." />
                        <TextBlock Style="{StaticResource Muted}" Text="• Duplo clique edita o texto direto no papel." />
                        <TextBlock Style="{StaticResource Muted}" Text="• O painel da direita ajusta fonte, alinhamento e campos." />
                        <TextBlock Style="{StaticResource Muted}" Text="• Salve com Ctrl+S; a prévia mostra o resultado impresso." />
                    </StackPanel>
                    <Button Content="Começar" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Margin="0,14,0,0"
                            Command="{Binding DismissWelcomeCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
