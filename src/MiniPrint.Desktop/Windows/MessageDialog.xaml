<Window x:Class="MiniPrint.Desktop.Windows.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniPrint Desktop"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=PrimaryButton}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,24,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBadge" Grid.Column="0" Width="40" Height="40" CornerRadius="11"
                    VerticalAlignment="Top" Background="{StaticResource InfoSoftBrush}">
                <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="19"
                           HorizontalAlignment="Center" Foreground="{StaticResource InfoBrush}" />
            </Border>

            <TextBlock x:Name="MessageText" Grid.Column="1" Margin="16,2,0,0"
                       TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}"
                        MinWidth="88" Margin="0,0,8,0" Click="OnSecondary" />
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                        MinWidth="88" IsDefault="True" Click="OnPrimary" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
