<Window x:Class="MiniPrint.Desktop.Windows.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Localizar e substituir"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        ShowInTaskbar="False">

    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="Localizar e substituir" Style="{StaticResource PageTitle}" FontSize="17" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="Procura nos textos fixos do documento. Campos dinâmicos não são alterados." />

            <TextBlock Text="Localizar" Style="{StaticResource Label}" />
            <TextBox x:Name="FindBox" TextChanged="OnFindChanged" />

            <TextBlock Text="Substituir por" Style="{StaticResource Label}" Margin="0,10,0,4" />
            <TextBox x:Name="ReplaceBox" />

            <CheckBox x:Name="MatchCaseBox" Content="Diferenciar maiúsculas de minúsculas"
                      Margin="0,10,0,0" Checked="OnFindChanged" Unchecked="OnFindChanged" />

            <TextBlock x:Name="ResultText" Style="{StaticResource Muted}" Margin="0,10,0,0"
                       Text="Digite o texto para localizar." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Fechar" Style="{StaticResource SecondaryButton}" Padding="14,7"
                        IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="ReplaceButton" Content="Substituir" Style="{StaticResource SecondaryButton}"
                        Padding="14,7" Margin="0,0,8,0" Click="OnReplace" />
                <Button x:Name="ReplaceAllButton" Content="Substituir tudo" Style="{StaticResource PrimaryButton}"
                        Padding="16,7" Click="OnReplaceAll" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
