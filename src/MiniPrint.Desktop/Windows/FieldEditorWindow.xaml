<Window x:Class="MiniPrint.Desktop.Windows.FieldEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campo dinâmico"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        ShowInTaskbar="False">

    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="Novo campo" Style="{StaticResource PageTitle}" FontSize="17" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="O rótulo é o nome que aparece no formulário de preenchimento. A chave interna é gerada automaticamente." />

            <TextBlock Text="Rótulo" Style="{StaticResource Label}" />
            <TextBox x:Name="LabelBox" TextChanged="OnInputChanged" MaxLength="60" />

            <TextBlock Text="Tipo de dado" Style="{StaticResource Label}" Margin="0,10,0,4" />
            <ComboBox x:Name="TypeBox" DisplayMemberPath="Label" SelectedValuePath="Type" />

            <TextBlock Text="Texto de orientação (opcional)" Style="{StaticResource Label}" Margin="0,10,0,4" />
            <TextBox x:Name="PlaceholderBox" MaxLength="120" />

            <TextBlock Text="Valor padrão (opcional)" Style="{StaticResource Label}" Margin="0,10,0,4" />
            <TextBox x:Name="DefaultBox" MaxLength="120" />

            <CheckBox x:Name="RequiredBox" Content="Campo obrigatório" Margin="0,10,0,0" />

            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Chave interna (usada no texto com {{chave}})" Style="{StaticResource Label}" />
                    <TextBlock x:Name="KeyText" Style="{StaticResource Mono}" FontSize="12.5" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Padding="14,7"
                        IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Salvar campo" Style="{StaticResource PrimaryButton}" Padding="16,7"
                        IsDefault="True" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
