<Window x:Class="MiniPrint.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MiniPrint.Desktop.Views"
        xmlns:theme="clr-namespace:MiniPrint.Desktop.Themes"
        Title="MiniPrint Desktop"
        Icon="assets/app.ico"
        Width="1280" Height="840"
        MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        SizeChanged="OnWindowSizeChanged"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navegação lateral e conteúdo -->
        <TabControl x:Name="NavTabs" Grid.Row="0"
                    Style="{StaticResource NavTabControl}"
                    SelectedIndex="{Binding SelectedTab}">

            <!-- Marca -->
            <theme:Chrome.SidebarHeader>
                <StackPanel x:Name="BrandRow" Orientation="Horizontal" Margin="19,24,16,18">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="{StaticResource IconPrint}" Style="{StaticResource Icon}"
                                   FontSize="17" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="BrandText" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MiniPrint" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource SidebarTextStrongBrush}" />
                        <TextBlock Text="Impressão térmica" FontSize="11.5"
                                   Foreground="{StaticResource SidebarTextBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </theme:Chrome.SidebarHeader>

            <!-- Estado da impressora -->
            <theme:Chrome.SidebarFooter>
                <Grid>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{Binding Printer.StatusBrush}"
                         Margin="0,8,0,24" Visibility="Collapsed" HorizontalAlignment="Center"
                         ToolTip="{Binding Printer.StatusText}" />
                <Border x:Name="StatusCard" Margin="12,8,12,14" Padding="14,12" CornerRadius="10"
                        Background="{StaticResource SidebarRaisedBrush}"
                        BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{Binding Printer.StatusBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Printer.StatusText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource SidebarTextStrongBrush}"
                                       Margin="9,0,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding Printer.ConnectedDeviceText}" FontSize="12"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   Margin="18,3,0,0" TextTrimming="CharacterEllipsis" />

                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6"
                                Padding="8,3" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="MODO SIMULADO" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>

                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="6"
                                Padding="8,4" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding Printer.HasWarning, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconWarning}" Style="{StaticResource Icon}"
                                           FontSize="11" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="{Binding Printer.HeaderWarning}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                                           Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="170" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding Printer.ConnectButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding Printer.ConnectCommand}"
                                    Padding="10,6" MinHeight="32"
                                    AutomationProperties.Name="Conectar ou desconectar impressora" />
                            <Button Grid.Column="2"
                                    Content="Pesquisar"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Printer.ScanCommand}"
                                    Padding="10,6" MinHeight="32"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource SidebarBorderBrush}"
                                    Foreground="{StaticResource SidebarTextStrongBrush}"
                                    AutomationProperties.Name="Pesquisar impressoras" />
                        </Grid>
                    </StackPanel>
                </Border>
                </Grid>
            </theme:Chrome.SidebarFooter>

            <TabItem Header="Imprimir" theme:Chrome.Icon="&#xE749;" Style="{StaticResource NavTabItem}">
                <views:PrintView DataContext="{Binding Print}" />
            </TabItem>

            <TabItem Header="Impressora" theme:Chrome.Icon="&#xE702;" Style="{StaticResource NavTabItem}">
                <views:PrinterView DataContext="{Binding Printer}" />
            </TabItem>

            <TabItem Header="Modelos" theme:Chrome.Icon="&#xE8F1;" Style="{StaticResource NavTabItem}">
                <views:TemplatesView DataContext="{Binding Templates}" />
            </TabItem>

            <TabItem Header="Histórico" theme:Chrome.Icon="&#xE81C;" Style="{StaticResource NavTabItem}">
                <views:HistoryView DataContext="{Binding History}" />
            </TabItem>

            <TabItem Header="Configurações" theme:Chrome.Icon="&#xE713;" Style="{StaticResource NavTabItem}">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>

            <TabItem Header="Diagnóstico" theme:Chrome.Icon="&#xE9D9;" Style="{StaticResource NavTabItem}">
                <views:DiagnosticsView DataContext="{Binding Diagnostics}" />
            </TabItem>
        </TabControl>

        <!-- Barra de estado -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid Height="30">
                <TextBlock Text="{Binding Printer.StatusDetail}"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Arraste uma imagem ou um .txt para a janela"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·" Margin="8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding VersionText}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
